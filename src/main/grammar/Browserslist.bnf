{
  parserClass="com.github.aleksandrsl.intellijbrowserslist.parser.BrowserslistParser"
  extends="com.intellij.extapi.psi.ASTWrapperPsiElement"

  psiClassPrefix="Browserslist"
  psiImplClassSuffix="Impl"
  psiPackage="com.github.aleksandrsl.intellijbrowserslist.psi"
  psiImplPackage="com.github.aleksandrsl.intellijbrowserslist.psi.impl"
  psiImplUtilClass="com.github.aleksandrsl.intellijbrowserslist.psi.BrowserslistPsiImplUtilKt"

  elementTypeHolderClass="com.github.aleksandrsl.intellijbrowserslist.psi.BrowserslistTypes"
  elementTypeClass="com.github.aleksandrsl.intellijbrowserslist.psi.BrowserslistElementType"
  tokenTypeClass="com.github.aleksandrsl.intellijbrowserslist.psi.BrowserslistTokenType"

  tokens=[
    EOL="regexp:\R"
    LBRACKET="["
    RBRACKET="]"
    PERCENT="regexp:\d*\.?\d+%"
    COMPARE="regexp:>=?|<=?"
    space="regexp:\s+"
    INTEGER="regexp:\d+"
    FLOAT="regexp:\d*\.?\d+"
    AND="and"
    OR="or"
  ]

  extends("(.+Query)") = query
  // Inspired by Rust. Recover statements with fast consume don't affect error messages anyway
  // and expression with fast consume is a standard practice
  consumeTokenMethod("((?!.*_with_recover).*_recover)")="consumeTokenFast"
}
browserslistFile ::= (EOL|COMMENT| fullSection | headlessSection)*
fake section ::= sectionHeader? sectionQueries? {methods=[getSectionName]}
fullSection ::= sectionHeader COMMENT? (EOL sectionQueries)? {pin=1 extends=section}
headlessSection ::= sectionQueries {extends=section}
// Cannot use name, because it clashes with a built it method
sectionHeader ::= '[' IDENTIFIER ']' {pin=1 recoverWhile="sectionHeader_recover" methods=[nameElement="IDENTIFIER"]}
private sectionHeader_recover ::= !(COMMENT | EOL)
private sectionQueries ::= (EOL|COMMENT)* queries_

// Could I not include COMMENT or EOL if there are no queries after it?
private queries_ ::= !(EOL | COMMENT | '[' | <<eof>>) queryExpression (EOL queryExpression|COMMENT|EOL !'[')* {pin = 1}

queryExpression ::=
 orExpression
 | andExpression
 | notExpression
 | simpleExpression

fake binaryExpression ::= queryExpression (AND | OR) queryExpression {
  methods=[
    left="/queryExpression[0]" // will be @NotNull as far as we have operator in the expression
    right="/queryExpression[1]" // "expr" is the name of the auto-calculated child property (singular or list)
  ]
  extends = queryExpression
}

orExpression ::= queryExpression OR queryExpression { extends=binaryExpression }
andExpression ::= queryExpression AND queryExpression { extends=binaryExpression }
notExpression ::= NOT simpleExpression { extends=queryExpression }
simpleExpression ::= query_with_recover { extends=queryExpression }

private query_with_recover ::= !(EOL | COMMENT | OR | AND | '[' | <<eof>>) query {pin=1 recoverWhile="query_recover"}
query ::=
    baselineQuery
    | statsQuery
    | lastQuery
    | timeQuery
    | unreleasedQuery
    | supportsQuery
    | targetQuery
    | extendsQuery
    | deadQuery
    | defaultsQuery
private query_recover ::= !(EOL|COMMENT|OR|AND|'[')

private version ::= 'version' | 'versions'
// TODO: Cover in custom stats like `cover 5% in browserslist-config-mycompany stats` should be supported?
statsQuery ::= (COMPARE|'cover') PERCENT ('in' IDENTIFIER 'stats'?)? {pin=1}
lastQuery ::= 'last' INTEGER TARGET? 'major'? version
unreleasedQuery ::= 'unreleased' TARGET? version {pin=1}
timeQuery ::= timeQueryLast_ | timeQuerySince_
private timeQueryLast_ ::= ('last' (FLOAT|INTEGER) 'years') {pin=3}
private timeQuerySince_ ::= 'since' (TIME|INTEGER) {pin=1}
// TODO (AleksandrSl 19/12/2025): Add lint for partially
supportsQuery ::= ('partially' | 'fully')? 'supports' IDENTIFIER {pin=2}
targetQuery ::=
    TARGET (COMPARE? TARGET_VERSION | TARGET_VERSIONS_RANGE)
    | 'current' TARGET
    | 'maintained' TARGET version
    {pin=1}
extendsQuery ::= 'extends' IDENTIFIER {pin=1}
deadQuery ::= 'dead' {pin=1}
defaultsQuery ::= 'defaults' {pin=1}
baselineQuery ::= 'baseline' (INTEGER | 'newly' 'available' | 'widely' 'available' ('on' TIME)?) ('with' 'downstream')? ('including' 'kaios')? {pin=1}
/*
wrong query - not recognized as query at all, i.e. pinned element is not reached)

Recover pitfalls
* wrong first query in the section or queries, breaks parsing of all downstream elements. Current section/queries is not recognised as such
  and recover doesn't work, nothing to pin
* wrong not first query breaks parsing till the end of section
* didn't managed to pin queries that start with last keyword, cause
  there are two different queries with first required different element in the end. Maybe I should just unify them, although they are different.
*/
